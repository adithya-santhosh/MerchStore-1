# Origin of the backend API — no trailing slash, no /api suffix (every call
# site appends /api/... itself; see src/lib/api.ts).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Byte-identical to the backend's JWT_SECRET (see backend/.env.example). No
# NEXT_PUBLIC_ prefix — this is read server-side only, by middleware.ts, to
# verify the admin role at the edge. If it differs from the backend's by even
# one character, every admin request silently redirects to /login.
JWT_SECRET=

# Absolute base URL used for SEO metadata, canonical links, sitemap and Open
# Graph tags (see src/lib/site-config.ts). Falls back to siteConfig.domain,
# then localhost, if unset — only required once you're ready for real
# canonical URLs instead of localhost ones.
NEXT_PUBLIC_SITE_URL=

# Sentry error tracking (optional — omit to run with no-op error tracking).
# SENTRY_DSN covers server-side errors (instrumentation.ts); NEXT_PUBLIC_SENTRY_DSN
# covers the browser (instrumentation-client.ts). Get both from the same
# Sentry project — they're usually the same DSN value, just exposed under two
# names because only the NEXT_PUBLIC_ one is safe to ship to the browser.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
