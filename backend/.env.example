PORT=5000
NODE_ENV=development

DATABASE_URL=

# Generate a strong JWT_SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Allowed frontend origin (update when deploying to production)
ALLOWED_ORIGIN=http://localhost:3000

# Number of reverse-proxy hops in front of this server, used to resolve the
# real client IP for rate limiting.
#
#   Render  = 2  (Render fronts every service with Cloudflare, so the chain is
#                 Cloudflare -> Render router -> app. Confirmed by the
#                 `Server: cloudflare` / `cf-ray` response headers.)
#   Bare VM behind one nginx = 1
#   Local development        = 0
#
# Setting this too LOW resolves req.ip to a rotating edge IP, so rate-limit
# buckets scatter and the limit stops meaning anything per-customer. Setting it
# too HIGH lets a client forge X-Forwarded-For and evade rate limiting — never
# set it above the number of proxies you actually control.
#
# Defaults to 1 when NODE_ENV=production, otherwise 0. On Render, set it to 2.
TRUST_PROXY_HOPS=2

# SameSite policy for the auth cookie: lax | none | strict
#
#   lax   -> USE THIS once the frontend and API share a registrable domain,
#            e.g. www.example.com + api.example.com. Browsers count those as the
#            same site, so the cookie is sent normally and is immune to
#            third-party-cookie restrictions.
#
#   none  -> required only while the two are on genuinely different sites
#            (e.g. *.vercel.app + *.onrender.com). Works today, but Safari ITP
#            and Chrome's third-party cookie phase-out restrict such cookies,
#            which surfaces as users being randomly signed out. Requires HTTPS.
#
# Defaults to "none" in production, "lax" otherwise. Switch to "lax" as soon as
# the API is reachable on a subdomain of the storefront's domain.
COOKIE_SAMESITE=

# Which hosts the auth cookie is sent to. Leave EMPTY for local development —
# the API (:5000) and storefront (:3000) share the host `localhost`, and cookies
# ignore the port, so a host-only cookie already reaches both.
#
# In production you MUST set this, e.g. COOKIE_DOMAIN=.example.com. The API and
# the storefront live on different subdomains, and a host-only cookie set by
# api.example.com is never sent to www.example.com. The Next.js middleware that
# gates /admin and /dashboard reads the cookie from requests to the STOREFRONT,
# so without this it finds nothing and redirects every admin back to /login —
# while ordinary API calls keep working, which makes it look like a login bug
# rather than a cookie-scope one.
#
# Requires both to sit under one registrable domain. A storefront on
# example.com with the API on *.onrender.com cannot share a cookie at all.
COOKIE_DOMAIN=

# Public base URL of the frontend. Used to build links inside outgoing emails
# (e.g. the password-reset link). MUST be set to the real domain in production,
# otherwise reset emails will point customers at localhost.
FRONTEND_URL=http://localhost:3000

# Transactional email (Resend). If RESEND_API_KEY is unset, emails are not sent
# — they're logged to the console instead, which is fine for local development
# but means password resets will NOT reach customers in production.
RESEND_API_KEY=
EMAIL_FROM="MerchStore <onboarding@resend.dev>"

RAZORPAY_KEY_ID=
RAZORPAY_SECRET=

CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
