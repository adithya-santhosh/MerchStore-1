PORT=5000
NODE_ENV=development

DATABASE_URL=

# Generate a strong JWT_SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Allowed frontend origin (update when deploying to production)
ALLOWED_ORIGIN=http://localhost:3000

# Number of reverse-proxy hops in front of this server, used to resolve the
# real client IP for rate limiting.
#
#   Render  = 2  (Render fronts every service with Cloudflare, so the chain is
#                 Cloudflare -> Render router -> app. Confirmed by the
#                 `Server: cloudflare` / `cf-ray` response headers.)
#   Bare VM behind one nginx = 1
#   Local development        = 0
#
# Setting this too LOW resolves req.ip to a rotating edge IP, so rate-limit
# buckets scatter and the limit stops meaning anything per-customer. Setting it
# too HIGH lets a client forge X-Forwarded-For and evade rate limiting — never
# set it above the number of proxies you actually control.
#
# Defaults to 1 when NODE_ENV=production, otherwise 0. On Render, set it to 2.
TRUST_PROXY_HOPS=2

# Public base URL of the frontend. Used to build links inside outgoing emails
# (e.g. the password-reset link). MUST be set to the real domain in production,
# otherwise reset emails will point customers at localhost.
FRONTEND_URL=http://localhost:3000

# Transactional email (Resend). If RESEND_API_KEY is unset, emails are not sent
# — they're logged to the console instead, which is fine for local development
# but means password resets will NOT reach customers in production.
RESEND_API_KEY=
EMAIL_FROM="MerchStore <onboarding@resend.dev>"

RAZORPAY_KEY_ID=
RAZORPAY_SECRET=

CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
